# RDS PostgreSQL and ElastiCache Redis.
#
# Both sit in private subnets with no route to the internet, reachable only from the API task
# security group. Both are deliberately modest and deliberately single-node; Section 13 records
# what that costs and Chapter 65 rehearses the restore that pays for it.

resource "aws_db_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.private[*].id
}

resource "random_password" "database" {
  length = 40
  # RDS rejects several punctuation characters in a master password, and a generated value that
  # the API then has to survive round-tripping through a task definition is not the place to find
  # out which. Alphanumeric at this length is ample.
  special = false
}

resource "aws_secretsmanager_secret" "database_password" {
  name        = "${local.name}/THAAP_POSTGRES_PASSWORD"
  description = "RDS master password. Generated by Terraform, read by the task at runtime."
}

resource "aws_secretsmanager_secret_version" "database_password" {
  secret_id     = aws_secretsmanager_secret.database_password.id
  secret_string = random_password.database.result
}

resource "aws_db_instance" "main" {
  identifier     = local.name
  engine         = "postgres"
  engine_version = "16"

  instance_class        = var.database_instance_class
  allocated_storage     = var.database_allocated_storage
  max_allocated_storage = var.database_allocated_storage * 4
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "thaap_payments"
  username = "thaap"
  password = random_password.database.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.database.id]
  publicly_accessible    = false

  # Single-AZ is a recorded cost tradeoff, not an oversight: an availability-zone failure is
  # downtime plus a restore rather than a failover (Section 13).
  multi_az = false

  backup_retention_period = var.database_backup_retention_days
  backup_window           = "18:00-19:00"
  maintenance_window      = "Sun:19:30-Sun:20:30"

  # A minor-version bump that lands during a demo is a worse outcome than a deferred patch, and
  # the upgrade is a deliberate operator action in the Chapter 65 runbook.
  auto_minor_version_upgrade = false

  # The whole point of this instance is that it can be restored (C65-DATA-001). A destroy that
  # left no final snapshot would remove the only artifact that proof depends on.
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.name}-final"
  deletion_protection       = true

  performance_insights_enabled    = false
  enabled_cloudwatch_logs_exports = ["postgresql"]

  tags = { Name = local.name }
}

resource "aws_elasticache_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.private[*].id
}

# Redis is ephemeral risk coordination per ADR-0010: losing it degrades velocity features rather
# than corrupting durable truth, which is why one node with no replica is an acceptable shape
# here and would not be for the database.
resource "aws_elasticache_cluster" "main" {
  cluster_id           = local.name
  engine               = "redis"
  engine_version       = "7.1"
  node_type            = var.cache_node_type
  num_cache_nodes      = 1
  parameter_group_name = "default.redis7"
  port                 = 6379

  subnet_group_name  = aws_elasticache_subnet_group.main.name
  security_group_ids = [aws_security_group.cache.id]

  tags = { Name = local.name }
}
