# Application Load Balancer and the second of the three Section 5.1 exposure layers.
#
# The WAF sits on CloudFront. That protects the distribution and does nothing whatsoever for the
# ALB, which keeps its own resolvable *.elb.amazonaws.com hostname — so an edge control alone
# leaves the origin reachable by anyone who learns that name from a redirect, a header or a
# certificate. The listener below therefore refuses by default and admits only requests carrying
# the shared secret CloudFront injects.
#
# That is also what makes Chapter 62's `server.forward-headers-strategy: framework` safe. A caller
# who can reach the ALB directly chooses its own X-Forwarded-For, and with it the per-client-IP
# rate limits and the per-IP fraud velocity signal.

resource "aws_lb" "main" {
  name               = local.name
  load_balancer_type = "application"
  internal           = false
  subnets            = aws_subnet.public[*].id
  security_groups    = [aws_security_group.alb.id]

  drop_invalid_header_fields = true
  enable_deletion_protection = false

  # Longer than the API's own request timeouts so the balancer is never the component that gives
  # up first — a 504 from the ALB tells an operator nothing about which dependency was slow.
  idle_timeout = 65

  tags = { Name = local.name }
}

resource "aws_lb_target_group" "api" {
  name        = "${local.name}-api"
  port        = 8080
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = aws_vpc.main.id

  # Bound to readiness, not liveness. Readiness aggregates sixteen indicators; liveness only says
  # the process exists, so a task that cannot reach PostgreSQL would stay in rotation answering
  # requests it cannot serve.
  #
  # ER-0104 is why the idle case matters here: readiness used to report DOWN on a healthy but
  # quiet system, which behind this target group would have removed every task from rotation
  # about five minutes after traffic went quiet — permanently, for a demo that is idle by design.
  health_check {
    path                = "/actuator/health/readiness"
    protocol            = "HTTP"
    matcher             = "200"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 4
  }

  # Long enough for the JVM to finish in-flight work under graceful shutdown.
  deregistration_delay = 30

  tags = { Name = "${local.name}-api" }
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = aws_acm_certificate_validation.alb.certificate_arn

  # Fail closed. Anything that did not arrive through CloudFront gets this, not the application.
  # The body says nothing about what is behind it, because a 403 that names the product is a
  # confirmation to whoever is probing.
  default_action {
    type = "fixed-response"

    fixed_response {
      content_type = "text/plain"
      message_body = "Forbidden"
      status_code  = "403"
    }
  }
}

# The rule that authorises. CloudFront adds this header to every origin request; nothing else
# knows the value, because it is generated by Terraform and read from Secrets Manager.
resource "aws_lb_listener_rule" "cloudfront_only" {
  listener_arn = aws_lb_listener.https.arn
  priority     = 100

  condition {
    http_header {
      http_header_name = "X-Thaap-Origin-Verify"
      values           = [random_password.cloudfront_origin_secret.result]
    }
  }

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.api.arn
  }
}

# The origin's port 80 stays closed. CloudFront uses HTTPS only; no unreachable plaintext
# redirect listener is advertised as an operational path.
